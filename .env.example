# Aether uses Firebase AI Logic (App Check) for Gemini — no GEMINI_API_KEY is required.
# Configure these secrets in the AI Studio Secrets panel (never commit real keys):

# GOOGLE_MAPS_API_KEY: Google Maps Platform API key (supports Google Weather API / WeatherNext 3 & Map Tiles)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# GOOGLE_WEATHER_API_KEY: Optional dedicated Google Maps Platform Weather API key (powered by WeatherNext 3)
# Endpoint: https://weather.googleapis.com/v1/
GOOGLE_WEATHER_API_KEY=YOUR_GOOGLE_WEATHER_API_KEY

# WEATHERNEXT_AUTH_TOKEN: Optional Bearer token for an authorized WeatherNext 3 Cloud Run / Zarr proxy
WEATHERNEXT_AUTH_TOKEN=YOUR_WEATHERNEXT_AUTH_TOKEN
